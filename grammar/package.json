{
  "name": "grammatikinseln",
  "version": "1.0.0",
  "private": true,
  "description": "Gamified German grammar platform for B1.1 and B1.2 with Arabic and German explanations.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server.js",
    "preview": "node server.js --dist",
    "validate": "node scripts/validate-content.js",
    "test": "node --test \"test/*.test.js\"",
    "build": "node scripts/validate-content.js && node scripts/build.js",
    "build:series": "node scripts/build.js --with-series",
    "prepare:series": "node scripts/prepare-series-listening.js",
    "extract:legacy": "node scripts/extract-legacy.js",
    "new:lesson": "node scripts/new-lesson.js",
    "check:links": "node scripts/check-links.js",
    "test:visual": "node scripts/visual-check.js"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
